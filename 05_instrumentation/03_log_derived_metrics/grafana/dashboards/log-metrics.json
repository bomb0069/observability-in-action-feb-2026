      "datasource": { "type": "loki", "uid": "" },
      "targets": [
        {
          "expr": "max_over_time({service_name=~\".+\"} | json | event=\"end\" | unwrap duration_ms [5m]) by (function)",
          "refId": "A",
          "legendFormat": "{{function}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["max"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
