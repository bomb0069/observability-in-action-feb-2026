      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": { "mode": "size" },
          "yBuckets": { "mode": "count", "value": "10" }
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "unit": "ms"
        }
      }
    },
    {
      "title": "Function Call Flow (Logs)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "" },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} | json | function!=\"\"",
          "refId": "A"
